    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this LinkedIn comment.\n\nCommenter:\n{{ $json.commenterName }}\n\nComment:\n{{ $json.commentText }}\n\nPost:\n{{ $json.postText }}\n\nClassify the comment into EXACTLY ONE category:\n\n- Question\n- Praise\n- Potential Lead\n- Hater\n- Collaboration Opportunity\n\nPriority rules:\n\nQuestion → High\n\nPotential Lead → High\n\nCollaboration Opportunity → High\n\nPraise → Low\n\nHater → Low\n\nReturn ONLY valid JSON in this format:\n\n{\n  \"label\":\"\",\n  \"priority\":\"\",\n  \"reason\":\"\"\n}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert LinkedIn Community Manager.\n\nYour job is to analyze LinkedIn comments and determine which ones deserve immediate attention.\n\nRules:\n\nChoose exactly ONE label:\n\nQuestion\nPraise\nPotential Lead\nHater\nCollaboration Opportunity\n\nPriority rules:\n\nQuestion → High\n\nPotential Lead → High\n\nCollaboration Opportunity → High\n\nPraise → Low\n\nHater → Low\n\nReturn only valid JSON.\n\nUse this format:\n\n{\n  \"label\": \"\",\n  \"priority\": \"\",\n  \"reason\": \"\"\n}\n\nNever include markdown.\n\nNever explain anything outside the JSON."
            }
          ]
        },
